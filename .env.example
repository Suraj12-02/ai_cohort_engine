# ---- Database ----
# Full SQLAlchemy URL (preferred). Example for local Postgres:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cohort_engine

# Or individual parts (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cohort_engine
DB_USER=postgres
DB_PASSWORD=postgres

# ---- LLM Provider: choose ONE ----
LLM_PROVIDER=groq          # "groq" or "openai"

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
