# Copy this into Streamlit Community Cloud → your app → Settings → Secrets.
# Do NOT commit a real secrets.toml to GitHub — .streamlit/secrets.toml is
# already in .gitignore.
#
# For local testing you can also save this (filled in) as
# .streamlit/secrets.toml and Streamlit will read it automatically.

DATABASE_URL = "postgresql+psycopg2://user:password@host:5432/dbname"
DB_HOST = "your-neon-or-supabase-host"
DB_PORT = "5432"
DB_NAME = "cohort_engine"
DB_USER = "postgres"
DB_PASSWORD = "your_real_db_password"

LLM_PROVIDER = "groq"
GROQ_API_KEY = "gsk_your_real_key_here"
GROQ_MODEL = "llama-3.3-70b-versatile"

OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-4o-mini"
